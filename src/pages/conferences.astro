---
import SectionLayout from "../layouts/SectionLayout.astro";
import { getCollection } from "astro:content";

const conferences = await getCollection("conferences");
---

<SectionLayout
  title="Конференциялар"
  description="Ғылыми кездесулер мен конференция материалдары."
>
  {conferences.length === 0 ? (
    <p>Конференция материалдары жақында жарияланады.</p>
  ) : (
    <div class="conferences">
      {conferences.map((conference) => (
        <article class="conference">
          <h2>
            <a href={`/conferences/${conference.id.split("/").map(encodeURIComponent).join("/")}`}>
                {conference.data.title} ↗
            </a>
          </h2>
          <p>{conference.data.description}</p>
        </article>
      ))}
    </div>
  )}
</SectionLayout>

<style>
  .conference + .conference {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid #dce3dc;
  }

  h2 {
    margin: 0 0 12px;
    font-size: 24px;
    line-height: 1.3;
  }

  p {
    margin: 0;
    color: #596b65;
  }
</style>