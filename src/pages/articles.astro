---
import SectionLayout from "../layouts/SectionLayout.astro";
import { getCollection } from "astro:content";

const articles = await getCollection("articles");
---

<SectionLayout
  title="Мақалалар"
  description="Қазақ тілі мен әдебиетін оқытуға арналған ғылыми және әдістемелік мақалалар."
>
  {articles.length === 0 ? (
    <p>Мақалалар жақында жарияланады.</p>
  ) : (
    <div class="articles">
      {articles.map((article) => (
        <article class="article">
          <h2>
            <a href={`/articles/${article.id.split("/").map(encodeURIComponent).join("/")}`}>
                {article.data.title} ↗
             </a>
          </h2>
          <p>{article.data.description}</p>
        </article>
      ))}
    </div>
  )}
</SectionLayout>

<style>
  .article + .article {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid #dce3dc;
  }

  h2 {
    margin: 0 0 12px;
    font-size: 24px;
    line-height: 1.3;
  }

  p {
    margin: 0;
    color: #596b65;
  }
</style>