---
import { getCollection, render } from "astro:content";

const sections = [
  {
    title: "Конференциялар",
    description: "Ғылыми кездесулер мен конференция материалдары.",
  },
  {
    title: "Мақалалар",
    description: "Ғылыми және әдістемелік мақалалар.",
  },
  {
    title: "Диссертациялар",
    description: "Зерттеу жұмыстары мен ғылыми ізденістер.",
  },
  {
    title: "Дәрістер",
    description: "Қазақ тілі мен әдебиеті бойынша дәрістер.",
  },
  {
    title: "Тапсырмалар",
    description: "Оқу тапсырмалары мен практикалық жаттығулар.",
  },
  {
    title: "Құнды деректер",
    description: "Тіл, ұлттық мәдениет және құндылықтар туралы деректер.",
  },
  {
    title: "Бейнематериалдар",
    description: "Бейнесабақтар мен танымдық материалдар.",
  },
];

const [home] = await getCollection("home");
const { Content: AboutContent } = await render(home);
---

<!doctype html>
<html lang="kk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Қазақ тілі мен әдебиетін құндылық бағдарлы оқытуға арналған ғылыми-әдістемелік материалдар."
    />
    <title>Тіл — құндылық. Сөз — өнер.</title>
	<script
  		is:inline
  	src="https://identity.netlify.com/v1/netlify-identity-widget.js">
	</script>
	<script
  		is:inline
  		async
  		src="https://www.googletagmanager.com/gtag/js?id=G-0NQ06MK4BS">
	</script>

	<script is:inline>
  		window.dataLayer = window.dataLayer || [];
  		function gtag(){dataLayer.push(arguments);}
  		gtag("js", new Date());
  		gtag("config", "G-0NQ06MK4BS");
	</script>

  </head>

  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="Басты бет">
          <span class="brand-symbol" aria-hidden="true">Т</span>
          <span>
            <strong>Тіл — құндылық</strong>
            <span class="brand-subtitle">Сөз — өнер</span>
          </span>
        </a>

        <nav aria-label="Негізгі мәзір">
          <a href="/" aria-current="page">Басты бет</a>
          <a href="#materials">Материалдар</a>
          <a href="#about">Жоба туралы</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
		<div class="hero-ornament" aria-hidden="true"></div>
        <div class="container hero-inner">
          <p class="eyebrow">{home.data.eyebrow}</p>

          <h1 id="hero-title">
  			{home.data.title}<br />
  			<span>{home.data.title_accent}</span>
		  </h1>

          <p class="hero-description">{home.data.description}</p>

          <a class="button" href="#materials">
            Материалдарды қарау <span aria-hidden="true">↗</span>
          </a>

          <div class="hero-bottom">
            <span>ТІЛ</span>
            <span>БІЛІМ</span>
            <span>ҰЛТТЫҚ МҰРА</span>
          </div>
        </div>
      </section>

      <section
        id="materials"
        class="materials container"
        aria-labelledby="materials-title"
      >
        <div class="section-heading">
          <div>
            <p class="eyebrow">БІЛІМ КЕҢІСТІГІ</p>
            <h2 id="materials-title">Материалдар</h2>
          </div>
          <p>Оқытуға, ізденуге және тәжірибе алмасуға арналған бөлімдер.</p>
        </div>

        <div class="cards">
          {
            sections.map((section, index) => (
              <article class="card">
                <span class="card-number">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3>
  				  {section.title === "Мақалалар" ? (
    				<a href="/articles">Мақалалар ↗</a>
  				  ) : section.title === "Конференциялар" ? (
    				<a href="/conferences">Конференциялар ↗</a>
				  ) : section.title === "Диссертациялар" ? (
    				<a href="/dissertations">Диссертациялар ↗</a>
				  ) : section.title === "Дәрістер" ? (
    				<a href="/lectures">Дәрістер ↗</a>
			      ) : section.title === "Тапсырмалар" ? (
    				<a href="/tasks">Тапсырмалар ↗</a>
				  ) : section.title === "Құнды деректер" ? (
    				<a href="/resources">Құнды деректер ↗</a>
				  ) : section.title === "Бейнематериалдар" ? (
    				<a href="/videos">Бейнематериалдар ↗</a>
  				  ) : (
    				section.title
  				  )}
			    </h3>
                <p>{section.description}</p>
              </article>
            ))
          }
        </div>
      </section>
		<section class="analytics" aria-labelledby="analytics-title">
		<div class="container">
			<p class="eyebrow">СТАТИСТИКА</p>
			<h2 id="analytics-title">Сайт көрсеткіштері</h2>

			<div class="analytics-grid">
			<div class="analytics-card">
				<strong id="stat-visitors">—</strong>
				<span>Сайтқа келушілердің саны</span>
			</div>

			<div class="analytics-card">
				<strong id="stat-active">—</strong>
				<span>Қазір сайтта</span>
			</div>

			<div class="analytics-card">
				<strong id="stat-views">—</strong>
				<span>Барлық қаралымдар саны</span>
			</div>

			<div class="analytics-card">
				<strong id="stat-downloads">—</strong>
				<span>Жүктеулер саны</span>
			</div>
			</div>

			<div class="section-views">
			<h3>Бөлімдер бойынша қаралымдар</h3>
			<ul id="section-views-list">
				<li>Жүктелуде…</li>
			</ul>
			</div>
		</div>
		</section>

      <section id="about" class="about" aria-labelledby="about-title">
        <div class="container about-inner">
          <div>
            <p class="eyebrow">ЖОБА ТУРАЛЫ</p>
            <h2 id="about-title">Тіл мен білім.<br />Мәдениет пен құндылық.</h2>
          </div>
          <div class="about-text">
  			<p>{home.data.about}</p>
		  </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <span>Тіл — құндылық. Сөз — өнер.</span>
        <span>Қазақ тілі · Білім · Мәдениет</span>
      </div>
    </footer>
	<script is:inline>
	const sectionLabels = {
		"/articles": "Мақалалар",
		"/conferences": "Конференциялар",
		"/dissertations": "Диссертациялар",
		"/lectures": "Дәрістер",
		"/tasks": "Тапсырмалар",
		"/resources": "Құнды деректер",
		"/videos": "Бейнематериалдар",
	};

	const loadAnalytics = async () => {
		try {
		const response = await fetch(
			`/.netlify/functions/analytics?ts=${Date.now()}`
		);

		if (!response.ok) {
			throw new Error("Analytics request failed");
		}

		const data = await response.json();

		document.querySelector("#stat-visitors").textContent =
			data.visitors.toLocaleString("ru-RU");

		document.querySelector("#stat-active").textContent =
			data.activeUsersNow.toLocaleString("ru-RU");

		document.querySelector("#stat-views").textContent =
			data.pageViews.toLocaleString("ru-RU");

		document.querySelector("#stat-downloads").textContent =
			data.pdfDownloads.toLocaleString("ru-RU");

		const list = document.querySelector("#section-views-list");

		list.innerHTML = Object.entries(data.sectionViews)
			.map(
			([path, views]) =>
				`<li><span>${sectionLabels[path]}</span><strong>&nbsp;${views.toLocaleString("ru-RU")}</strong></li>`
			)
			.join("");
		} catch (error) {
		console.error(error);
		}
	};

	loadAnalytics();
	</script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-padding-top: 24px;
  }

  :global(body) {
    margin: 0;
    background: #faf9f6;
    color: #173d39;
    font-family: "Segoe UI", Arial, sans-serif;
    line-height: 1.6;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  :global(a:focus-visible) {
    outline: 3px solid #a56f20;
    outline-offset: 5px;
  }

  :global(h1),
  :global(h2),
  :global(h3),
  :global(p) {
    margin: 0;
  }

  .container {
    width: min(1120px, calc(100% - 48px));
    margin-inline: auto;
  }

  .site-header {
    background: #fff;
    border-bottom: 1px solid #e5e8e2;
  }

  .header-inner {
    min-height: 100px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 20px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .brand-symbol {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid #b28b50;
    border-radius: 50%;
    font-family: Georgia, serif;
    font-size: 28px;
  }

  .brand strong {
    display: block;
    font-size: 19px;
  }

  .brand-subtitle {
    display: block;
    color: #657470;
    font-size: 14px;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    font-size: 14px;
    font-weight: 600;
  }

  nav a {
    padding-block: 6px;
  }

  nav a:hover,
  nav a[aria-current="page"] {
    text-decoration: underline;
    text-underline-offset: 7px;
  }

  .hero {
    background: #123f39;
    color: #fff;
  }

  .hero-inner {
    padding-block: 80px 28px;
  }

  .eyebrow {
    color: #75603a;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.15em;
  }

  .hero .eyebrow {
    color: #e0c38f;
  }

  h1 {
    margin-top: 24px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(44px, 7vw, 86px);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  h1 span {
    color: #e0c38f;
  }

  .hero-description {
    max-width: 590px;
    margin-top: 28px;
    color: #e0e9e5;
    font-size: 19px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    margin-top: 32px;
    padding: 14px 24px;
    background: #e6cd9f;
    color: #173d39;
    border-radius: 6px;
    font-weight: 700;
  }

  .button:hover {
    background: #f2deb9;
  }

  .hero-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: 64px;
    padding-top: 22px;
    border-top: 1px solid #446760;
    color: #d3e0db;
    font-size: 11px;
    letter-spacing: 0.16em;
  }

  .materials {
    padding-block: 72px;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 30px;
  }

  h2 {
    margin-top: 10px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(30px, 4vw, 42px);
    font-weight: 400;
    line-height: 1.25;
  }

  .section-heading > p {
    max-width: 350px;
    color: #596b65;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .card {
    padding: 28px;
    border: 1px solid #dce3dc;
    border-radius: 10px;
    background: #fff;
  }

  .card-number {
    color: #806638;
    font-size: 13px;
    letter-spacing: 0.1em;
  }

  .card h3 {
    margin-top: 26px;
    font-size: 21px;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }

  .card p {
    margin-top: 12px;
    color: #596b65;
    font-size: 15px;
  }

  .about {
    padding-block: 56px;
    background: #edf1eb;
  }

  .about-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 48px;
  }

  .about-inner > p {
    color: #4d6259;
    font-size: 17px;
  }

  .site-footer {
    padding-block: 26px;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: #596b65;
    font-size: 13px;
  }

  @media (max-width: 900px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .container {
      width: calc(100% - 32px);
    }

    .header-inner,
    .section-heading,
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    nav {
      gap: 18px;
    }

    .hero-inner {
      padding-top: 48px;
    }

    .hero-description {
      font-size: 17px;
    }

    .materials {
      padding-block: 48px;
    }

    .cards,
    .about-inner {
      grid-template-columns: 1fr;
    }

    .about-inner {
      gap: 24px;
    }
  }
  .about-text {
    color: #4d6259;
    font-size: 17px;
  }

  .about-text :global(p) {
    margin: 0 0 16px;
  }
	.analytics {
	padding: 88px 0;
	background: #f0f4ef;
	}

	.analytics h2 {
	margin: 10px 0 32px;
	font-family: Georgia, "Times New Roman", serif;
	font-size: clamp(34px, 5vw, 56px);
	font-weight: 400;
	line-height: 1.15;
	}

	.analytics-grid {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
	gap: 18px;
	margin-bottom: 32px;
	}

	.analytics-card {
	padding: 26px;
	background: #fff;
	border: 1px solid #dce3dc;
	border-radius: 10px;
	}

	.analytics-card strong {
	display: block;
	margin-bottom: 8px;
	color: #173d39;
	font-family: Georgia, "Times New Roman", serif;
	font-size: 40px;
	font-weight: 400;
	}

	.analytics-card span {
	color: #596b65;
	font-size: 15px;
	}

	.top-articles {
	max-width: 720px;
	padding: 26px;
	background: #fff;
	border: 1px solid #dce3dc;
	border-radius: 10px;
	}

	.top-articles h3 {
	margin: 0 0 16px;
	font-size: 20px;
	}

	.top-articles ol {
	margin: 0;
	padding-left: 22px;
	color: #596b65;
	}

	.top-articles li + li {
	margin-top: 8px;
	}

	@media (max-width: 700px) {
	.analytics-grid {
		grid-template-columns: 1fr;
	}
	}
	.section-views {
	max-width: 720px;
	margin-top: 24px;
	padding: 26px;
	background: #fff;
	border: 1px solid #dce3dc;
	border-radius: 10px;
	}

	.section-views h3 {
	margin: 0 0 16px;
	font-size: 20px;
	}

	.section-views ul {
	display: grid;
	gap: 10px;
	margin: 0;
	padding: 0;
	list-style: none;
	}

	.section-views li {
	display: flex;
	justify-content: space-between;
	gap: 20px;
	padding-bottom: 8px;
	color: #596b65;
	border-bottom: 1px solid #edf0ec;
	}

	.section-views li strong {
	color: #173d39;
	}
  /* Desktop: 96px ribbon and 114px clear space before the text. */
  .hero {
    --ornament-width: 96px;
    --ornament-gap: 114px;
    --hero-text-left: max(234px, calc((100% - 1120px) / 2));
    position: relative;
    overflow: hidden;
  }

  .hero-ornament {
    position: absolute;
    inset-block: 0;
    left: calc(var(--hero-text-left) - var(--ornament-gap) - var(--ornament-width));
    width: var(--ornament-width);
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22108%22%20height%3D%22114%22%20viewBox%3D%220%200%20108%20114%22%3E%3Cg%20fill%3D%22none%22%20stroke%3D%22%23e0c38f%22%3E%3Cpath%20stroke-width%3D%222.5%22%20d%3D%22M2%200V114M106%200V114%22%2F%3E%3Cg%20stroke-width%3D%229%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22M%2028%2C28%20C%2017%2C34%2010%2C20%2019%2C12%20C%2031%2C1%2047%2C10%2051%2C25%20C%2058%2C50%2037%2C62%2024%2C75%20C%2012%2C87%2012%2C101%2023%2C108%20C%2036%2C117%2049%2C107%2047%2C96%20C%2045%2C85%2035%2C81%2029%2C87%20C%2026%2C90%2027%2C94%2030%2C95%22%2F%3E%3Cpath%20transform%3D%22translate%28108%200%29%20scale%28-1%201%29%22%20d%3D%22M%2028%2C28%20C%2017%2C34%2010%2C20%2019%2C12%20C%2031%2C1%2047%2C10%2051%2C25%20C%2058%2C50%2037%2C62%2024%2C75%20C%2012%2C87%2012%2C101%2023%2C108%20C%2036%2C117%2049%2C107%2047%2C96%20C%2045%2C85%2035%2C81%2029%2C87%20C%2026%2C90%2027%2C94%2030%2C95%22%2F%3E%3C%2Fg%3E%3C%2Fg%3E%3Cpath%20fill%3D%22%23e0c38f%22%20d%3D%22M54%2059Q57%2069%2064%2073Q57%2077%2054%2086Q51%2077%2044%2073Q51%2069%2054%2059Z%22%2F%3E%3C%2Fsvg%3E");
    background-size: 100% auto;
    background-repeat: repeat-y;
  }

  .hero-inner {
    position: relative;
    width: min(1120px, calc(100% - var(--hero-text-left) - 24px));
    margin-left: var(--hero-text-left);
    margin-right: 24px;
  }

  @media (max-width: 1100px) {
    .hero {
      --ornament-width: 72px;
      --ornament-gap: 48px;
      --hero-text-left: 144px;
    }
  }

  @media (max-width: 640px) {
    .hero {
      --ornament-width: 40px;
      --ornament-gap: 20px;
      --hero-text-left: 76px;
    }

    .hero-inner {
      width: calc(100% - var(--hero-text-left) - 16px);
      margin-right: 16px;
    }

    .hero h1 {
      font-size: clamp(32px, 7vw, 44px);
      overflow-wrap: anywhere;
    }

    .hero .button {
      max-width: 100%;
      padding-inline: 16px;
      gap: 12px;
    }
  }
</style>
