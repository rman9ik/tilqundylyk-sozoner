---
import SectionLayout from "../../layouts/SectionLayout.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const videos = await getCollection("videos");

  return videos.map((video) => ({
    params: { id: video.id },
    props: { video },
  }));
}

interface Props {
  video: CollectionEntry<"videos">;
}

const { video } = Astro.props;
const { Content } = await render(video);

function getEmbedUrl(url?: string | null) {
  if (!url) return null;

  try {
    const parsed = new URL(url);

    if (parsed.hostname === "youtu.be") {
      return `https://www.youtube.com/embed/${parsed.pathname.slice(1)}`;
    }

    if (parsed.hostname.includes("youtube.com")) {
      const id = parsed.searchParams.get("v");
      return id ? `https://www.youtube.com/embed/${id}` : null;
    }
  } catch {
    return null;
  }

  return null;
}

const embedUrl = getEmbedUrl(video.data.video_url);
---

<SectionLayout
  title={video.data.title}
  description={video.data.description}
>
  {embedUrl && (
    <div class="video-frame">
      <iframe
        src={embedUrl}
        title={video.data.title}
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      />
    </div>
  )}

  {video.data.cover && (
    <img
      class="cover"
      src={video.data.cover}
      alt={video.data.cover_alt || ""}
    />
  )}

  <article class="content">
    <Content />
  </article>

  <a class="back-to-list" href="/videos">
    ← Бейнематериалдар тізіміне оралу
  </a>
</SectionLayout>

<style>
  .video-frame {
    position: relative;
    width: 100%;
    max-width: 820px;
    aspect-ratio: 16 / 9;
    margin-bottom: 32px;
    overflow: hidden;
    border-radius: 10px;
    background: #173d39;
  }

  iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .cover {
    display: block;
    max-width: 100%;
    max-height: 520px;
    margin-bottom: 28px;
    border-radius: 8px;
  }

  .content {
    max-width: 760px;
    font-size: 18px;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  .back-to-list {
    display: inline-block;
    margin-top: 32px;
    color: #173d39;
    text-underline-offset: 5px;
  }

  a:focus-visible {
    outline: 3px solid #a56f20;
    outline-offset: 5px;
  }
</style>