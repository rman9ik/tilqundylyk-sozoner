---
import SectionLayout from "../layouts/SectionLayout.astro";
import { getCollection } from "astro:content";

const videos = await getCollection("videos");
---

<SectionLayout
  title="Бейнематериалдар"
  description="Бейнесабақтар мен танымдық материалдар."
>
  {videos.length === 0 ? (
    <p>Бейнематериалдар жақында жарияланады.</p>
  ) : (
    <div class="videos">
      {videos.map((video) => (
        <article class="video">
          <h2>
            <a
              href={`/videos/${video.id
                .split("/")
                .map(encodeURIComponent)
                .join("/")}`}
            >
              {video.data.title} ↗
            </a>
          </h2>
          <p>{video.data.description}</p>
        </article>
      ))}
    </div>
  )}
</SectionLayout>

<style>
  .video + .video {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid #dce3dc;
  }

  h2 {
    margin: 0 0 12px;
    font-size: 24px;
    line-height: 1.3;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  p {
    margin: 0;
    color: #596b65;
  }
</style>