---
import SectionLayout from "../../layouts/SectionLayout.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const conferences = await getCollection("conferences");

  return conferences.map((conference) => ({
    params: { id: conference.id },
    props: { conference },
  }));
}

interface Props {
  conference: CollectionEntry<"conferences">;
}

const { conference } = Astro.props;
const { Content } = await render(conference);
---

<SectionLayout
  title={conference.data.title}
  description={conference.data.description}
>
  {conference.data.cover && (
    <img
      class="cover"
      src={conference.data.cover}
      alt={conference.data.cover_alt || ""}
    />
  )}

  <article class="content">
    <Content />
  </article>

  {conference.data.pdf && (
    <div class="download">
      <a class="pdf-button" href={conference.data.pdf} download>
        PDF жүктеп алу ↓
      </a>
    </div>
  )}

  <a class="back-to-list" href="/conferences">
    ← Конференциялар тізіміне оралу
  </a>
</SectionLayout>

<style>
  .cover {
    display: block;
    max-width: 100%;
    width: auto;
    height: auto;
    max-height: 520px;
    margin-bottom: 28px;
    border-radius: 8px;
  }

  .content {
    max-width: 760px;
    font-size: 18px;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  .content :global(img) {
    max-width: 100%;
    height: auto;
  }

  .content :global(a) {
    color: #173d39;
    text-decoration: underline;
  }

  .download {
    margin-top: 28px;
  }

  .pdf-button {
    display: inline-block;
    padding: 12px 22px;
    border-radius: 6px;
    background: #173d39;
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }

  .pdf-button:hover {
    background: #24594f;
  }

  .back-to-list {
    display: inline-block;
    margin-top: 32px;
    color: #173d39;
    text-underline-offset: 5px;
  }

  a:focus-visible {
    outline: 3px solid #a56f20;
    outline-offset: 5px;
  }
</style>