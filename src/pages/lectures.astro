---
import SectionLayout from "../layouts/SectionLayout.astro";
import { getCollection } from "astro:content";

const lectures = await getCollection("lectures");
---

<SectionLayout
  title="Дәрістер"
  description="Қазақ тілі мен әдебиеті бойынша дәрістер."
>
  {lectures.length === 0 ? (
    <p>Дәрістер жақында жарияланады.</p>
  ) : (
    <div class="lectures">
      {lectures.map((lecture) => (
        <article class="lecture">
          <h2>
            <a
              href={`/lectures/${lecture.id
                .split("/")
                .map(encodeURIComponent)
                .join("/")}`}
            >
              {lecture.data.title} ↗
            </a>
          </h2>
          <p>{lecture.data.description}</p>
        </article>
      ))}
    </div>
  )}
</SectionLayout>

<style>
  .lecture + .lecture {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid #dce3dc;
  }

  h2 {
    margin: 0 0 12px;
    font-size: 24px;
    line-height: 1.3;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  p {
    margin: 0;
    color: #596b65;
  }
</style>