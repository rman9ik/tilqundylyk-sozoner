---
import SectionLayout from "../layouts/SectionLayout.astro";
import { getCollection } from "astro:content";

const resources = await getCollection("resources");
---

<SectionLayout
  title="Құнды деректер"
  description="Тіл, ұлттық мәдениет және құндылықтар туралы деректер."
>
  {resources.length === 0 ? (
    <p>Материалдар жақында жарияланады.</p>
  ) : (
    <div class="resources">
      {resources.map((resource) => (
        <article class="resource">
          <h2>
            <a
              href={`/resources/${resource.id
                .split("/")
                .map(encodeURIComponent)
                .join("/")}`}
            >
              {resource.data.title} ↗
            </a>
          </h2>
          <p>{resource.data.description}</p>
        </article>
      ))}
    </div>
  )}
</SectionLayout>

<style>
  .resource + .resource {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid #dce3dc;
  }

  h2 {
    margin: 0 0 12px;
    font-size: 24px;
    line-height: 1.3;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  p {
    margin: 0;
    color: #596b65;
  }
</style>