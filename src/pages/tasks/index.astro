---
import SectionLayout from "../../layouts/SectionLayout.astro";
import { getCollection } from "astro:content";

const tasks = await getCollection("tasks");
---

<SectionLayout
  title="Тапсырмалар"
  description="Оқу тапсырмалары, практикалық жаттығулар және LearningApps тапсырмалары."
>
  {tasks.length === 0 ? (
    <p>Әзірге тапсырмалар жоқ.</p>
  ) : (
    <div class="task-grid">
      {tasks.map((task) => (
        <article class="task-card">
          {task.data.cover ? (
            <img class="task-cover" src={task.data.cover}
              alt={task.data.cover_alt || ""} loading="lazy" />
          ) : task.data.learningapps_url ? (
            <div class="task-placeholder" aria-hidden="true">
              <span class="placeholder-symbol">↗</span>
              <span>LearningApps</span>
            </div>
          ) : null}
          <div class="task-body">
            {task.data.learningapps_url && <span class="task-label">ИНТЕРАКТИВТІ ТАПСЫРМА</span>}
            <h2>{task.data.title}</h2>
            <p>{task.data.description}</p>
            <div class="task-actions">
              {task.data.learningapps_url ? (
                <>
                  <a class="task-button" href={task.data.learningapps_url}
                    target="_blank" rel="noopener noreferrer">
                    LearningApps-та ашу <span aria-hidden="true">↗</span>
                    <span class="sr-only"> (жаңа қойындыда)</span>
                  </a>
                  {(task.body?.trim() || task.data.pdf) && (
                    <a class="details" href={`/tasks/${task.id}/`}>Толығырақ →</a>
                  )}
                </>
              ) : (
                <a class="task-button" href={`/tasks/${task.id}/`}>Тапсырманы ашу →</a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  )}
</SectionLayout>

<style>
  .task-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .task-card { display: flex; flex-direction: column; min-width: 0; overflow: hidden; border: 1px solid #dce3dc; border-radius: 12px; background: #fff; }
  .task-cover { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .task-placeholder { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; aspect-ratio: 16 / 9; background: #edf1eb; color: #173d39; font-size: 20px; font-weight: 600; }
  .placeholder-symbol { display: grid; place-items: center; width: 54px; height: 54px; border-radius: 12px; background: #e6cd9f; font-size: 30px; }
  .task-body { display: flex; flex: 1; flex-direction: column; padding: 24px; }
  .task-label { color: #75603a; font-size: 11px; font-weight: 700; letter-spacing: .08em; margin-bottom: 12px; }
  h2 { margin: 0; color: #173d39; font-size: 22px; line-height: 1.35; overflow-wrap: anywhere; }
  p { margin: 14px 0 24px; color: #596b65; line-height: 1.6; overflow-wrap: anywhere; }
  .task-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: auto; }
  .task-button { display: inline-flex; align-items: center; gap: 8px; padding: 12px 16px; border-radius: 6px; background: #173d39; color: #fff; text-decoration: none; font-size: 14px; font-weight: 600; }
  .task-button:hover { background: #285b50; }
  .details { color: #173d39; text-underline-offset: 4px; }
  a:focus-visible { outline: 3px solid #a56f20; outline-offset: 4px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  @media (max-width: 1000px) { .task-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .task-grid { grid-template-columns: 1fr; } }
</style>
