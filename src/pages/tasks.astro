---
import SectionLayout from "../layouts/SectionLayout.astro";
import { getCollection } from "astro:content";

const tasks = await getCollection("tasks");
---

<SectionLayout
  title="Тапсырмалар"
  description="Оқу тапсырмалары мен практикалық жаттығулар."
>
  {tasks.length === 0 ? (
    <p>Тапсырмалар жақында жарияланады.</p>
  ) : (
    <div class="tasks">
      {tasks.map((task) => (
        <article class="task">
          <h2>
            <a
              href={`/tasks/${task.id
                .split("/")
                .map(encodeURIComponent)
                .join("/")}`}
            >
              {task.data.title} ↗
            </a>
          </h2>
          <p>{task.data.description}</p>
        </article>
      ))}
    </div>
  )}
</SectionLayout>

<style>
  .task + .task {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid #dce3dc;
  }

  h2 {
    margin: 0 0 12px;
    font-size: 24px;
    line-height: 1.3;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  p {
    margin: 0;
    color: #596b65;
  }
</style>