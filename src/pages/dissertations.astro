---
import SectionLayout from "../layouts/SectionLayout.astro";
import { getCollection } from "astro:content";

const dissertations = await getCollection("dissertations");
---

<SectionLayout
  title="Диссертациялар"
  description="Зерттеу жұмыстары мен ғылыми ізденістер."
>
  {dissertations.length === 0 ? (
    <p>Диссертациялар жақында жарияланады.</p>
  ) : (
    <div class="dissertations">
      {dissertations.map((dissertation) => (
        <article class="dissertation">
          <h2>
            <a
              href={`/dissertations/${dissertation.id
                .split("/")
                .map(encodeURIComponent)
                .join("/")}`}
            >
              {dissertation.data.title} ↗
            </a>
          </h2>
          <p>{dissertation.data.description}</p>
        </article>
      ))}
    </div>
  )}
</SectionLayout>

<style>
  .dissertation + .dissertation {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid #dce3dc;
  }

  h2 {
    margin: 0 0 12px;
    font-size: 24px;
    line-height: 1.3;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  p {
    margin: 0;
    color: #596b65;
  }
</style>