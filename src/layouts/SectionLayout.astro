---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="kk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Мақалалар | Тіл — құндылық</title>
    <meta
      name="description"
      content="Қазақ тілі мен әдебиетін оқытуға арналған ғылыми және әдістемелік мақалалар."
    />
  </head>

  <body>
    <header>
      <a class="brand" href="/">Тіл — құндылық. Сөз — өнер.</a>
    </header>

    <main>
      <a class="back" href="/#materials">← Материалдарға оралу</a>

      <p class="eyebrow">ҒЫЛЫМИ-ӘДІСТЕМЕЛІК МАТЕРИАЛДАР</p>
      <h1>Мақалалар</h1>
      <p class="description">
        Қазақ тілі мен әдебиетін оқытуға арналған ғылыми және
        әдістемелік мақалалар.
      </p>

      <div class="empty-state">
        <h2>Мақалалар жақында жарияланады</h2>
        <p>Бұл бөлімге ғылыми және әдістемелік еңбектер қосылады.</p>
      </div>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #faf9f6;
    color: #173d39;
    font-family: "Segoe UI", Arial, sans-serif;
    line-height: 1.6;
  }

  a {
    color: inherit;
    text-underline-offset: 5px;
  }

  a:focus-visible {
    outline: 3px solid #a56f20;
    outline-offset: 5px;
  }

  header {
    padding: 24px max(24px, calc((100% - 1120px) / 2));
    background: #fff;
    border-bottom: 1px solid #dce3dc;
  }

  .brand {
    font-size: 20px;
    font-weight: 700;
    text-decoration: none;
  }

  main {
    width: min(1120px, calc(100% - 48px));
    margin: 40px auto 80px;
  }

  .back {
    display: inline-block;
    margin-bottom: 40px;
  }

  .eyebrow {
    color: #75603a;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  h1 {
    margin: 12px 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(36px, 6vw, 64px);
    font-weight: 400;
    line-height: 1.2;
  }

  .description {
    max-width: 650px;
    color: #596b65;
    font-size: 18px;
  }

  .empty-state {
    margin-top: 40px;
    padding: 32px;
    background: #fff;
    border: 1px solid #dce3dc;
    border-radius: 10px;
  }

  .empty-state h2 {
    margin: 0 0 12px;
    font-size: 22px;
  }

  .empty-state p {
    margin: 0;
    color: #596b65;
  }
</style>